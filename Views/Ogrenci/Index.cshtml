@model IEnumerable<OgrenciBilgiSistemi.Models.Ogrenci>

@{
    ViewData["Title"] = "Öğrenci Listesi";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-people-fill me-2"></i>Öğrenci Yönetimi
            </h2>
            <p class="text-muted small mb-0">Sistemde kayıtlı öğrencileri listeleyebilir, yeni kayıt ekleyebilir veya mevcut bilgileri düzenleyebilirsiniz.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 shadow-sm rounded-3">
            <i class="bi bi-person-plus-fill me-2"></i>Yeni Öğrenci Ekle
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom">
                        <tr>
                            <th class="ps-4 py-3 text-secondary small text-uppercase fw-semibold">Öğrenci No</th>
                            <th class="py-3 text-secondary small text-uppercase fw-semibold">T.C. Kimlik No</th>
                            <th class="py-3 text-secondary small text-uppercase fw-semibold">Ad Soyad</th>
                            <th class="py-3 text-secondary small text-uppercase fw-semibold">E-Posta</th>
                            <th class="py-3 text-secondary small text-uppercase fw-semibold">Sınıf</th>
                            <th class="py-3 text-secondary small text-uppercase fw-semibold">Kayıt Türü</th>
                            <th class="py-3 text-secondary small text-uppercase fw-semibold">Durum</th>
                            <th class="pe-4 py-3 text-end text-secondary small text-uppercase fw-semibold">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    Henüz kayıtlı bir öğrenci bulunmamaktadır.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@item.OgrenciNo</td>
                                    <td class="text-secondary">@item.TcKimlikNo</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.Ad @item.Soyad</div>
                                    </td>
                                    <td class="text-muted">@item.KurumsalEposta</td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1">@item.Sinif. Sınıf</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">@item.KayitTuru</span>
                                    </td>
                                    <td>
                                        @if (item.DurumAktifMi)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Pasif</span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Düzenle">
                                                Düzenle
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu öğrenciyi silmek istediğinize emin misiniz?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" title="Sil">
                                                    Sil
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>