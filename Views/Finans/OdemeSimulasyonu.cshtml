@{
    ViewData["Title"] = "Banka Harç Ödeme Simülasyonu";
}

<div class="container mt-4">
    <h2><i class="bi bi-bank me-2"></i>Banka Harç Ödeme ve Mutabakat Simülasyonu</h2>
    <hr />

    @if (TempData["Mesaj"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Mesaj"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm p-4 col-md-6">
        <form asp-action="OdemeSimulasyonuYap" method="post">
            <div class="mb-3">
                <label class="form-label fw-bold">Öğrenci Numarası</label>
                <input type="text" name="ogrenciNo" class="form-control" placeholder="Örn: 2026001" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Ödenen Tutar (TL)</label>
                <input type="number" step="0.01" name="odenenTutar" class="form-control" placeholder="Örn: 1500.00" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Banka Kodu</label>
                <select name="bankaKodu" class="form-select">
                    <option value="VAKIFBANK">VakıfBank</option>
                    <option value="ZIRAAT">Ziraat Bankası</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-send-check me-1"></i>Ödemeyi Simüle Et ve Borcu Düş
            </button>
        </form>
    </div>
</div>