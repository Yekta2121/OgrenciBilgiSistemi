@model IEnumerable<OgrenciBilgiSistemi.Models.OgrenciNot>

@{
    ViewData["Title"] = "Öğrenci Transkripti";
    var ogrenci = ViewBag.Ogrenci as OgrenciBilgiSistemi.Models.Ogrenci;
    double agno = ViewBag.AGNO;
    int toplamKredi = ViewBag.ToplamKredi;
    int basariliKredi = ViewBag.BasariliKredi;
    int mezuniyetKredisi = ViewBag.MezuniyetIcinGerekliKredi;
    bool mezunOlduMu = ViewBag.MezunOlduMu;
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-file-earmark-text-fill me-2"></i>Öğrenci Transkripti (Karne)
            </h2>
            <p class="text-muted small mb-0">Öğrencinin aldığı tüm dersleri ve AGNO (Genel Not Ortalaması) özetini görüntülersiniz.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-arrow-left me-1"></i>Not Listesine Dön
        </a>
    </div>

    @if (ogrenci != null)
    {
        <!-- Öğrenci Bilgi Kartı ve AGNO Özeti -->
        <div class="row g-3 mb-4">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-light">
                    <div class="card-body p-4">
                        <h4 class="fw-bold text-dark mb-3">@ogrenci.Ad @ogrenci.Soyad</h4>
                        <div class="row text-secondary small g-2 mb-3">
                            <div class="col-sm-6"><strong>Öğrenci No:</strong> @ogrenci.OgrenciNo</div>
                            <div class="col-sm-6"><strong>TC Kimlik No:</strong> @ogrenci.TcKimlikNo</div>
                            <div class="col-sm-6"><strong>E-posta:</strong> @ogrenci.KurumsalEposta</div>
                            <div class="col-sm-6"><strong>Bölüm / Sınıf:</strong> @(ogrenci.Bolum?.BolumAdi ?? "Bölüm Yok") / @ogrenci.Sinif. Sınıf</div>
                        </div>

                        <!-- Mezuniyet Kredi İlerleme Çubuğu -->
                        <div class="pt-3 border-top">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Mezuniyet Kredi Durumu (Başarılı / Bölüm Şartı):</span>
                                <span class="fw-bold text-dark">@basariliKredi / @mezuniyetKredisi Kredi</span>
                            </div>
                            <div class="progress" style="height: 8px;">
                                @{
                                    int yuzde = mezuniyetKredisi > 0 ? (basariliKredi * 100) / mezuniyetKredisi : 0;
                                    if (yuzde > 100) { yuzde = 100; }
                                }
                                <div class="progress-bar bg-success" role="progressbar" style="width: @yuzde%;" aria-valuenow="@basariliKredi" aria-valuemin="0" aria-valuemax="@mezuniyetKredisi"></div>
                            </div>
                            <div class="mt-2 d-flex justify-content-between align-items-center">
                                <span class="text-muted small">İlerleme: %@yuzde</span>
                                @if (mezunOlduMu)
                                {
                                    <span class="badge bg-success"><i class="bi bi-mortarboard-fill me-1"></i>Mezuniyete Uygun</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Eğitimi Devam Ediyor</span>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 bg-primary text-white text-center d-flex flex-column justify-content-center p-3">
                    <h6 class="text-white-50 text-uppercase small fw-bold mb-1">AGNO (4.00 Üzerinden)</h6>
                    <h1 class="display-4 fw-bold mb-0">@agno.ToString("0.00")</h1>
                    <span class="small mt-1 text-white-50">Toplam Alınan Kredi: @toplamKredi</span>
                </div>
            </div>
        </div>
    }

    <!-- Ders Listesi Tablosu -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom">
                        <tr>
                            <th class="ps-4 py-3 text-secondary small text-uppercase fw-semibold">Ders Kodu & Adı</th>
                            <th class="py-3 text-secondary small text-uppercase fw-semibold">Yerel Kredi</th>
                            <th class="py-3 text-secondary small text-uppercase fw-semibold">Vize</th>
                            <th class="py-3 text-secondary small text-uppercase fw-semibold">Final/Büt</th>
                            <th class="py-3 text-secondary small text-uppercase fw-semibold">Harf Notu</th>
                            <th class="py-3 text-secondary small text-uppercase fw-semibold">Katsayı</th>
                            <th class="pe-4 py-3 text-end text-secondary small text-uppercase fw-semibold">Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    Bu öğrenciye ait girilmiş not bulunmamaktadır.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@item.Ders?.DersAdi</div>
                                        <div class="text-muted small">@item.Ders?.DersKodu</div>
                                    </td>
                                    <td class="fw-semibold">@(item.Ders?.YerelKredi ?? 3)</td>
                                    <td class="fw-semibold">@(item.VizeNotu.HasValue ? item.VizeNotu.Value.ToString("0.##") : "-")</td>
                                    <td class="fw-semibold">
                                        @(item.ButunlemeNotu.HasValue ? item.ButunlemeNotu.Value.ToString("0.##") : (item.FinalNotu.HasValue ? item.FinalNotu.Value.ToString("0.##") : "-"))
                                    </td>
                                    <td>
                                        <span class="badge bg-dark px-2 py-1 fs-6">@item.HarfNotu</span>
                                    </td>
                                    <td class="fw-bold text-primary">@item.HarfNotuKatsayisi.ToString("0.00")</td>
                                    <td class="pe-4 text-end">
                                        @if (item.GectiMi)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-check-circle me-1"></i>Geçti
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-x-circle me-1"></i>Kaldı
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>