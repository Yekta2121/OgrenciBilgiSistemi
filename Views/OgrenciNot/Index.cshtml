@model IEnumerable<OgrenciBilgiSistemi.Models.OgrenciNot>

@{
    ViewData["Title"] = "Not Yönetimi";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-calculator me-2"></i>Not Girişi ve Durum Kontrolü
            </h2>
            <p class="text-muted small mb-0">Öğrencilerin sınav notlarını yönetebilir ve transkriptlerine ulaşabilirsiniz.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4 py-2 shadow-sm rounded-3">
            <i class="bi bi-plus-circle me-2"></i>Yeni Not Girişi
        </a>
    </div>

    <!-- Arama ve Filtreleme Paneli -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control border-start-0 ps-0" placeholder="Öğrenci adı, soyadı veya no ile ara..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="dersId" class="form-select" asp-items="ViewBag.Dersler">
                        <option value="">-- Tüm Dersler (Filtresiz) --</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100 shadow-sm">
                        <i class="bi bi-funnel me-1"></i>Filtrele
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Sıfırla">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom">
                        <tr>
                            <th class="ps-4 py-3 text-secondary small text-uppercase fw-semibold">Öğrenci No / Ad Soyad</th>
                            <th class="py-3 text-secondary small text-uppercase fw-semibold">Ders</th>
                            <th class="py-3 text-secondary small text-uppercase fw-semibold">Vize (%40)</th>
                            <th class="py-3 text-secondary small text-uppercase fw-semibold">Final (%60)</th>
                            <th class="py-3 text-secondary small text-uppercase fw-semibold">Bütünleme</th>
                            <th class="py-3 text-secondary small text-uppercase fw-semibold">Harf Notu</th>
                            <th class="py-3 text-secondary small text-uppercase fw-semibold">Katsayı</th>
                            <th class="py-3 text-secondary small text-uppercase fw-semibold">Durum</th>
                            <th class="pe-4 py-3 text-end text-secondary small text-uppercase fw-semibold">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    Kayıt bulunamadı.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@item.Ogrenci?.Ad @item.Ogrenci?.Soyad</div>
                                        <div class="text-muted small">@item.Ogrenci?.OgrenciNo</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.Ders?.DersAdi</div>
                                        <div class="text-muted small">@item.Ders?.DersKodu (Kredi: @item.Ders?.Kredi)</div>
                                    </td>
                                    <td class="fw-semibold">@(item.VizeNotu.HasValue ? item.VizeNotu.Value.ToString("0.##") : "-")</td>
                                    <td class="fw-semibold">@(item.FinalNotu.HasValue ? item.FinalNotu.Value.ToString("0.##") : "-")</td>
                                    <td class="fw-semibold">@(item.ButunlemeNotu.HasValue ? item.ButunlemeNotu.Value.ToString("0.##") : "-")</td>
                                    <td>
                                        <span class="badge bg-dark px-2 py-1 fs-6">@item.HarfNotu</span>
                                    </td>
                                    <td class="fw-bold text-primary">@item.HarfNotuKatsayisi.ToString("0.00")</td>
                                    <td>
                                        @if (item.GectiMi)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-check-circle me-1"></i>Geçti
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-x-circle me-1"></i>Kaldı
                                            </span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="Transkript" asp-route-id="@item.OgrenciId" class="btn btn-outline-info btn-sm" title="Transkript Görüntüle">
                                                <i class="bi bi-file-earmark-text"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm" title="Düzenle">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu not kaydını silmek istediğinize emin misiniz?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Sil">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>